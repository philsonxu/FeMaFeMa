<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FEM2D</RootNamespace>
    <AssemblyName>FEM2D</AssemblyName>
    <ApplicationIcon />
    <StartupObject>FEM2D.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>13</LangVersion>
    <BaseOutputPath>C:\Yohoo\FEM2D\bin\</BaseOutputPath>
    <IntermediateOutputPath>C:\Yohoo\FEM2D\obj\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0-preview.4.25220.4" />
  </ItemGroup>

</Project>
