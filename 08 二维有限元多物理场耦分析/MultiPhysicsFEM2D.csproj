<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MultiPhysicsFEM2D</RootNamespace>
    <AssemblyName>MultiPhysicsFEM2D</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <BaseOutputPath>C:\Yohoo\FEM2D\bin\</BaseOutputPath>
    <IntermediateOutputPath>C:\Yohoo\FEM2D\obj\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Examples\*.inp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
